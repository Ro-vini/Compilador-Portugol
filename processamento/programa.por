inteiro idade
idade <- 18
se idade >= 18 então
    escreva("Maior de idade")
senão
    escreva("Menor de idade")
fim_se



inteiro idade
inteiro i
string nome

leia(nome)
leia(idade)

se idade >= 18 então
    escreva("Maior de idade")
senão
    escreva("Menor de idade")
fim_se

para i <- 1 até 5 passo 1
    escreva("Repetição número ")
    escreva(i)
fim_para

se idade <> 0 e idade <= 150 então
    escreva("Idade válida")
senão
    escreva("Idade inválida")
fim_se